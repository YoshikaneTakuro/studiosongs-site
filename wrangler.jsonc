// Cloudflare Workers（静的サイト）の設定
{
  "name": "studiosongs-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "*studiosongs.net/*", "zone_name": "studiosongs.net" }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
